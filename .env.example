# Anthropic: the key is the sk-ant-… secret. ANTHROPIC_MODEL is the
# product name from the console (e.g. claude-sonnet-4-6), not another key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Approved template to open / ping outside the 24h session window
WHATSAPP_NEW_CONVERSATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
WHATSAPP_ESCALATION_TEMPLATE=

# Desk handset that receives the "needs human" WhatsApp ping
ALERT_WHATSAPP_NUMBER=+351912338809
ALERT_EMAIL_TO=info@fabricacoffeeroasters.com

SUPPORT_EMAIL_ADDRESS=support@fabricacoffeeroasters.com
SUPPORT_EMAIL_PASSWORD=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

ADMIN_PASSWORD=
EMAIL_POLL_SECRET=
